{% extends 'base.html.twig' %}

{% block title %}{{ service.title }} - Agence de Voyage{% endblock %}

{% block body %}
    <div style="margin-bottom: 2rem;">
        <a href="{{ path('app_home') }}" class="btn btn-info" style="display: inline-flex; align-items: center; gap: 0.5rem;">
            ← Retour à l'accueil
        </a>
    </div>

    <div class="card" style="max-width: 900px; margin: 0 auto;">
        {% if service.imageFilename %}
            <div class="service-detail-image-container">
                <img src="{{ vich_uploader_asset(service, 'imageFile') }}" alt="{{ service.title }}" class="service-detail-image">
            </div>
        {% endif %}
        
        <div style="padding: 1rem 0;">
            <h1 style="font-size: 2.5rem; margin-bottom: 1rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                {{ service.title }}
            </h1>
            
            <p style="color: var(--text-light); margin: 1.5rem 0; line-height: 1.8; font-size: 1.125rem;">{{ service.description }}</p>
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin: 2.5rem 0; padding: 1.5rem; background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%); border-radius: 12px; border: 2px solid rgba(102, 126, 234, 0.2);">
                <div>
                    <p style="font-size: 0.875rem; color: var(--text-light); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px;">Prix</p>
                    <p style="font-size: 2.5rem; font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin: 0;">
                        {{ service.price|number_format(2, ',', ' ') }} €
                    </p>
                </div>
                <div style="text-align: right;">
                    {% if service.available %}
                        <span class="badge badge-success" style="font-size: 0.875rem; padding: 0.5rem 1rem;">✓ Disponible</span>
                    {% else %}
                        <span class="badge badge-danger" style="font-size: 0.875rem; padding: 0.5rem 1rem;">✗ Indisponible</span>
                    {% endif %}
                </div>
            </div>

            {% if service.available %}
                {% if app.user %}
                    <div style="background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%); padding: 2rem; border-radius: 12px; margin-top: 2rem;">
                        <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem; color: var(--text-dark);">Réserver ce service</h2>
                        <form action="{{ path('app_reserve', {id: service.id}) }}" method="post">
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
                                <div>
                                    <label for="quantity">Quantité</label>
                                    <input type="number" id="quantity" name="quantity" min="1" value="1" required />
                                </div>
                                <div>
                                    <label for="dateFrom">Date de départ</label>
                                    <input type="date" id="dateFrom" name="dateFrom" />
                                </div>
                                <div>
                                    <label for="dateTo">Date de retour</label>
                                    <input type="date" id="dateTo" name="dateTo" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1.5rem; padding: 1rem; font-size: 1.125rem;">
                                Réserver maintenant
                            </button>
                        </form>
                    </div>
                {% else %}
                    <div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); padding: 1.5rem; border-radius: 12px; margin-top: 2rem; border-left: 4px solid #f59e0b;">
                        <p style="margin: 0; color: #92400e; font-weight: 600;">
                            <a href="{{ path('app_login') }}" style="color: #667eea; text-decoration: none; font-weight: 700;">Connectez-vous</a> ou 
                            <a href="{{ path('app_register') }}" style="color: #667eea; text-decoration: none; font-weight: 700;">inscrivez-vous</a> 
                            pour réserver ce service.
                        </p>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
{% endblock %}
