{% extends 'base.html.twig' %}

{% block title %}{{ service.title }} - Agence de Voyage{% endblock %}

{% block body %}
    <div style="margin-bottom: 2rem;">
        <a href="{{ path('app_home') }}" style="color: #0066cc; text-decoration: none;">← Retour à l'accueil</a>
    </div>

    <div class="card">
        {% if service.imageFilename %}
            <div class="service-detail-image-container">
                <img src="{{ vich_uploader_asset(service, 'imageFile') }}" alt="{{ service.title }}" class="service-detail-image">
            </div>
        {% endif %}
        <h1>{{ service.title }}</h1>
        <p style="color: #666; margin: 1rem 0;">{{ service.description }}</p>
        
        <div style="margin: 2rem 0;">
            <p style="font-size: 2rem; color: #0066cc;"><strong>{{ service.price|number_format(2, ',', ' ') }} €</strong></p>
            {% if service.available %}
                <p style="color: green; font-weight: bold;">✓ Service disponible</p>
            {% else %}
                <p style="color: red; font-weight: bold;">✗ Service non disponible</p>
            {% endif %}
        </div>

        {% if service.available %}
            {% if app.user %}
                <form action="{{ path('app_reserve', {id: service.id}) }}" method="post">
                    <div>
                        <label for="quantity">Quantité</label>
                        <input type="number" id="quantity" name="quantity" min="1" value="1" required />
                    </div>
                    <div>
                        <label for="dateFrom">Date de départ</label>
                        <input type="date" id="dateFrom" name="dateFrom" />
                    </div>
                    <div>
                        <label for="dateTo">Date de retour</label>
                        <input type="date" id="dateTo" name="dateTo" />
                    </div>
                    <button type="submit">Réserver ce service</button>
                </form>
            {% else %}
                <p style="background: #fff3cd; padding: 1rem; border-radius: 4px; margin: 1rem 0;">
                    <a href="{{ path('app_login') }}">Connectez-vous</a> ou <a href="{{ path('app_register') }}">inscrivez-vous</a> pour réserver ce service.
                </p>
            {% endif %}
        {% endif %}
    </div>

    <style>
        .service-detail-image-container {
            width: 100%;
            max-height: 400px;
            overflow: hidden;
            margin: -1.5rem -1.5rem 2rem -1.5rem;
            background: #f0f0f0;
            border-radius: 4px 4px 0 0;
        }

        .service-detail-image {
            width: 100%;
            height: auto;
            max-height: 400px;
            object-fit: cover;
            display: block;
        }
    </style>
{% endblock %}
